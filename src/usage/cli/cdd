#!/usr/bin/env python3
"""Human-friendly local CLI for CodeDendrite."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[2]
IGNORE_SECTIONS = {
    "scan": "scan_exclude",
    "map": "map_exclude",
    "privacy": "privacy_mask",
}
MINIMAL_IGNORE = """# CodeDendrite ignore rules

[scan_exclude]
.codedendrite/
**/.codedendrite/
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
.git/
node_modules/
.venv/
venv/

[map_exclude]

[privacy_mask]
.env
.env.*
*secret*
*password*
*credential*
*api_key*
"""


def project_dir(raw: str | None) -> Path:
    target = Path(raw or ".").expanduser().resolve()
    if not target.is_dir():
        raise SystemExit(f"目录不存在：{target}")
    return target


def require_index(target: Path) -> None:
    if not (target / ".codedendrite" / "anchors.json").exists():
        raise SystemExit(f"该目录还没有 CodeDendrite 索引，先运行：cdd update {target}")


def python_env() -> dict:
    """子解释器的环境：必须带仓库根，否则桶模块互相 import 不了。

    入口点现在是桶里的模块（`build_file_index.py` 开头就是
    `from view.browser.dom_sidebar import ...`），而子进程的
    sys.path[0] 是脚本自己所在的目录，不是仓库根。`run_module` 一直带着，
    `run_script` 没带——于是所有脚本入口都死在 "No module named 'view'"。
    """
    env = os.environ.copy()
    old_path = env.get("PYTHONPATH")
    env["PYTHONPATH"] = (
        str(REPO_ROOT) if not old_path else str(REPO_ROOT) + os.pathsep + old_path
    )
    return env


def run_module(module: str, args: list[str]) -> int:
    command = [sys.executable, "-m", module, *args]
    return subprocess.run(command, cwd=REPO_ROOT, env=python_env(), check=False).returncode


def run_script(script: Path, args: list[str]) -> int:
    command = [sys.executable, str(script), *args]
    return subprocess.run(command, cwd=REPO_ROOT, env=python_env(), check=False).returncode


def unavailable(command: str, why: str) -> int:
    """A subcommand whose backend is not in this tree.

    Kept as a named refusal rather than a dead module string: a missing
    `tools.CodeDendrite.evaluation.*` reports "No module named 'tools'", which
    points at the old layout instead of at the actual answer.
    """
    print(f"{command} 不可用：{why}", file=sys.stderr)
    return 3


def open_output(path: Path, no_open: bool = False) -> int:
    if no_open:
        print(f"已生成，未自动打开：{path}")
        return 0
    if not path.exists():
        print(f"生成命令成功，但没有找到可视化文件：{path}", file=sys.stderr)
        return 1
    if sys.platform == "darwin":
        opener = "open"
    elif os.name == "nt":
        os.startfile(path)  # type: ignore[attr-defined]
        print(f"已打开：{path}")
        return 0
    else:
        opener = shutil.which("xdg-open")
        if not opener:
            print(f"系统没有找到 xdg-open，请手动打开：{path}")
            return 1
    result = subprocess.run(
        [opener, str(path)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode:
        print(f"自动打开失败，请手动打开：{path}", file=sys.stderr)
        return result.returncode
    print(f"已打开：{path}")
    return 0


def run_visual(
    module: str,
    args: list[str],
    output: Path,
    no_open: bool = False,
) -> int:
    result = run_module(module, args)
    if result:
        return result
    return open_output(output, no_open=no_open)


def run_visual_script(
    script: Path,
    args: list[str],
    output: Path,
    no_open: bool = False,
) -> int:
    result = run_script(script, args)
    if result:
        return result
    return open_output(output, no_open=no_open)


def normalize_file(raw: str, target: Path) -> str:
    path = Path(raw).expanduser()
    if not path.is_absolute():
        return raw
    try:
        return path.resolve().relative_to(target).as_posix()
    except ValueError:
        return str(path.resolve())


def json_count(path: Path, preferred_keys: tuple[str, ...]) -> str:
    if not path.exists():
        return "-"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return "无法读取"
    for key in preferred_keys:
        value = data.get(key) if isinstance(data, dict) else None
        if isinstance(value, (list, dict)):
            return str(len(value))
        if isinstance(value, int):
            return str(value)
    if isinstance(data, (list, dict)):
        return str(len(data))
    return "?"


def peek_file(target: Path, raw_path: str) -> int:
    """Read one file's anchors right now, without an index.

    Every read command asks the index first, which is right for questions about
    relations — those only exist once the whole tree has been seen. But "what is
    in this file" needs nothing of the sort, and refusing to answer it until a
    full scan has run is what makes a file outside the project, or one written a
    minute ago, invisible.

    Only what is in the file is reported, and the output says so. An anchor here
    has no callers and no callees, because whether anything calls it is not a
    property of this file.
    """
    candidate = Path(raw_path).expanduser()
    if not candidate.is_absolute():
        candidate = target / candidate
    candidate = candidate.resolve()
    if not candidate.is_file():
        print(f"没有这个文件：{candidate}")
        return 1

    codedendrite_root = REPO_ROOT
    if str(codedendrite_root) not in sys.path:
        sys.path.insert(0, str(codedendrite_root))
    try:
        from scanner.language.registry import create_analyzer, language_for_path
    except Exception as error:
        print(f"读不到语言注册表：{error}")
        return 1

    spec = language_for_path(candidate)
    if spec is None and not candidate.suffix:
        # A file with no extension is usually a script, and it says what it is on
        # its first line. Not guessing here would leave every CLI entry point in
        # a repository unreadable — including this one.
        try:
            first = candidate.open(encoding="utf8", errors="ignore").readline()
        except Exception:
            first = ""
        if first.startswith("#!"):
            for name, probe in (("python", "python"), ("javascript", "node"),
                                ("ruby", "ruby"), ("php", "php"), ("shell", "sh")):
                if probe in first:
                    spec = language_for_path("x." + {"python": "py", "javascript": "js",
                                                     "ruby": "rb", "php": "php",
                                                     "shell": "sh"}[name])
                    break
    if spec is None:
        print(f"不认识这个文件：{candidate.suffix or '(没有扩展名，也没有 shebang)'}")
        return 1
    analyzer = create_analyzer(candidate.parent, "probe" + spec.extensions[0])
    if analyzer is None:
        print(f"{spec.name}：只登记了扩展名，没有分析器")
        return 1

    try:
        module = analyzer.analyze_file(str(candidate))
    except Exception as error:
        print(f"解析失败：{error}")
        return 1

    functions = list(getattr(module, "functions", None) or [])
    classes = list(getattr(module, "classes", None) or [])
    imports = list(getattr(module, "imports", None) or [])
    entry_lines: list[int] = []
    if spec.name == "python":
        try:
            from scanner.language.python.genome import PythonExtractor
            extractor = PythonExtractor()
            extractor.project_root = target
            extracted = extractor.extract_file(str(candidate))
            entry_lines = [
                anchor.line_start
                for anchor in extracted.get_by_category("__main__")
            ]
        except Exception:
            entry_lines = []

    try:
        shown = candidate.relative_to(target)
    except ValueError:
        shown = candidate
    print(f"文件：{shown}")
    print(f"语言：{spec.name}")
    if classes:
        print(f"类：{', '.join(str(c) for c in classes[:20])}")
    if imports:
        print(f"import：{', '.join(str(i) for i in imports[:12])}"
              + (f" …共 {len(imports)}" if len(imports) > 12 else ""))
    if not functions and not entry_lines:
        print("没有解析出函数或方法。")
    else:
        print(f"符号 {len(functions) + len(entry_lines)} 个：")
        for fn in functions:
            name = getattr(fn, "name", "?")
            line = getattr(fn, "line_number", None)
            owner = getattr(fn, "class_name", None) or getattr(fn, "parent", None)
            label = f"{owner}.{name}" if owner else name
            print(f"  {label:<48s} {line if line else ''}")
        for line in entry_lines:
            print(f"  {'__main__':<48s} {line}")
    print("现算的，只有这个文件里的东西。谁调用它、它调用谁，要有索引才知道"
          "（cdd update）。")
    return 0


def show_status(target: Path) -> int:
    output = target / ".codedendrite"
    print(f"项目：{target}")
    print(f"索引：{output}")
    if not output.is_dir():
        print("状态：未建立（运行 cdd update）")
        return 1

    anchors = output / "anchors.json"
    relations = output / "relations.json"
    modules = output / "module_tree.json"
    print(f"状态：已建立")
    print(f"anchors：{json_count(anchors, ('anchors',))}")
    print(f"relations：{json_count(relations, ('edges', 'relations'))}")
    print(f"modules：{json_count(modules, ('semantic_modules', 'modules'))}")

    show_coverage(anchors, relations)

    existing = [path for path in (anchors, relations, modules) if path.exists()]
    if existing:
        newest = max(path.stat().st_mtime for path in existing)
        print(f"最近更新：{datetime.fromtimestamp(newest).isoformat(sep=' ', timespec='seconds')}")
    return 0


def show_coverage(anchors_path: Path, relations_path: Path) -> None:
    """Per language: how many anchors ended up joined to nothing.

    There is no honest recall number to print here. Recall needs a denominator —
    how many relations the source actually contains — and an index has no way to
    know that. Every denominator that can be built is contaminated: the edges it
    found describe only themselves; the call sites it saw include `print` and
    `document.querySelector`, which are supposed to stay unresolved; and matching
    unresolved calls by name drowns in `push` and `get`.

    So the one number reported is the share of anchors with no edge at all, said
    for what it is: a mixture of "nothing calls this" and "we could not work out
    what calls this". It cannot be split without ground truth, and pretending
    otherwise is how a graph missing half its edges passes for complete.

    A language with zero cross-file edges is flagged separately. That is not a
    rate — it is a statement about shape, and it is always worth saying.
    """
    import collections

    try:
        with anchors_path.open(encoding="utf8") as handle:
            anchors = json.load(handle)
        with relations_path.open(encoding="utf8") as handle:
            edges = (json.load(handle) or {}).get("edges") or []
    except Exception:
        return
    if not isinstance(anchors, dict) or not anchors:
        return

    degree = collections.Counter()
    cross = collections.Counter()
    total = collections.Counter()
    for edge in edges:
        source, target = edge.get("from_id"), edge.get("to_id")
        if source is None or target is None:
            continue
        degree[source] += 1
        degree[target] += 1
        lang = (anchors.get(source) or {}).get("language") or _lang_of(source)
        total[lang] += 1
        if str(source).split("::")[0] != str(target).split("::")[0]:
            cross[lang] += 1

    per = collections.defaultdict(lambda: [0, 0])
    for key, record in anchors.items():
        lang = (record or {}).get("language") or _lang_of(key)
        per[lang][0] += 1
        if degree[key] == 0:
            per[lang][1] += 1

    rows = [(lang, n, alone) for lang, (n, alone) in per.items() if n >= 5]
    rows.sort(key=lambda row: -row[1])
    if not rows:
        return
    print("图的构成：")
    print("  {:<12}{:>8}{:>8}{:>14}".format("语言", "anchor", "边", "可疑孤儿"))
    for lang, count, alone in rows:
        note = ""
        if total.get(lang, 0) > 0 and cross.get(lang, 0) == 0:
            note = "   ← 没有一条边跨文件，这门语言只连出了文件内部"
        print("  {:<12}{:>8}{:>8}{:>13.0f}%{}".format(lang, count, total.get(lang, 0),
                                                     100.0 * alone / count, note))
    print("  可疑孤儿 = 一条边都没有的 anchor，含「确实没人调」和「没能解析出来」，两者分不开。")


def _lang_of(anchor_id: str) -> str:
    """Fall back to the extension when an anchor never recorded its language."""
    import os
    ext = os.path.splitext(str(anchor_id).split("::")[0])[1].lower()
    return {
        ".py": "python", ".pyw": "python",
        ".js": "javascript", ".jsx": "javascript", ".mjs": "javascript", ".cjs": "javascript",
        ".ts": "typescript", ".tsx": "typescript",
        ".java": "java", ".go": "go", ".rs": "rust", ".rb": "ruby", ".php": "php",
        ".kt": "kotlin", ".swift": "swift", ".cs": "csharp",
        ".c": "cpp", ".cc": "cpp", ".cpp": "cpp", ".h": "cpp", ".hpp": "cpp",
    }.get(ext, ext.lstrip(".") or "(无扩展名)")


def ignore_file(target: Path) -> Path:
    return target / ".codedendrite_ignore"


def validate_ignore_pattern(pattern: str) -> str:
    pattern = pattern.strip()
    if not pattern:
        raise SystemExit("ignore 规则不能为空")
    if "\n" in pattern or "\r" in pattern:
        raise SystemExit("一条 ignore 规则不能包含换行")
    if pattern.startswith(("#", "[")):
        raise SystemExit("ignore 规则不能以 # 或 [ 开头")
    return pattern


def parse_ignore_rules(path: Path) -> dict[str, list[str]]:
    rules = {section: [] for section in IGNORE_SECTIONS.values()}
    if not path.exists():
        return rules
    current: str | None = None
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if line in {f"[{section}]" for section in rules}:
            current = line[1:-1]
        elif line.startswith("[") and line.endswith("]"):
            current = None
        elif current and line and not line.startswith("#"):
            rules[current].append(line)
    return rules


def init_ignore(target: Path) -> int:
    path = ignore_file(target)
    if path.exists():
        print(f"已存在：{path}")
        return 0
    path.write_text(MINIMAL_IGNORE, encoding="utf-8")
    print(f"已创建：{path}")
    print("按需添加规则，然后运行 cdd rebuild。")
    return 0


def list_ignore(target: Path, raw: bool = False) -> int:
    path = ignore_file(target)
    print(f"配置：{path}")
    if not path.exists():
        print("尚未创建。运行：cdd ignore init")
        return 1
    if raw:
        print(path.read_text(encoding="utf-8"), end="")
        return 0
    rules = parse_ignore_rules(path)
    labels = {
        "scan_exclude": "scan：完全不扫描",
        "map_exclude": "map：扫描但不展示",
        "privacy_mask": "privacy：展示符号但隐藏内容",
    }
    for section in ("scan_exclude", "map_exclude", "privacy_mask"):
        print(f"\n[{labels[section]}]  {len(rules[section])} 条")
        for pattern in rules[section]:
            print(f"  {pattern}")
    return 0


def add_ignore_rule(target: Path, kind: str, raw_pattern: str) -> int:
    path = ignore_file(target)
    if not path.exists():
        init_ignore(target)
    pattern = validate_ignore_pattern(raw_pattern)
    section = IGNORE_SECTIONS[kind]
    rules = parse_ignore_rules(path)
    if pattern in rules[section]:
        print(f"规则已存在：[{section}] {pattern}")
        return 0

    lines = path.read_text(encoding="utf-8").splitlines()
    header = f"[{section}]"
    if header not in lines:
        if lines and lines[-1].strip():
            lines.append("")
        lines.extend([header, pattern])
    else:
        start = lines.index(header)
        end = len(lines)
        for index in range(start + 1, len(lines)):
            stripped = lines[index].strip()
            if stripped.startswith("[") and stripped.endswith("]"):
                end = index
                break
        while end > start + 1 and not lines[end - 1].strip():
            end -= 1
        lines.insert(end, pattern)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"已添加：[{section}] {pattern}")
    print(f"配置：{path}")
    print("让旧索引彻底移除这些内容：cdd rebuild")
    return 0


def remove_ignore_rule(target: Path, kind: str, raw_pattern: str) -> int:
    path = ignore_file(target)
    if not path.exists():
        raise SystemExit("没有 .codedendrite_ignore；无需删除规则")
    pattern = validate_ignore_pattern(raw_pattern)
    section = IGNORE_SECTIONS[kind]
    current: str | None = None
    removed = False
    output: list[str] = []
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        stripped = raw_line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            current = stripped[1:-1]
        if current == section and stripped == pattern and not stripped.startswith("#"):
            removed = True
            continue
        output.append(raw_line)
    if not removed:
        print(f"未找到：[{section}] {pattern}")
        return 1
    path.write_text("\n".join(output) + "\n", encoding="utf-8")
    print(f"已删除：[{section}] {pattern}")
    print("让重新纳入的文件进入索引：cdd rebuild")
    return 0


def check_ignore(target: Path, raw_path: str) -> int:
    path = ignore_file(target)
    if not path.exists():
        raise SystemExit("没有 .codedendrite_ignore；先运行 cdd ignore init")
    candidate = Path(raw_path).expanduser()
    if not candidate.is_absolute():
        candidate = target / candidate
    candidate = candidate.resolve()

    codedendrite_root = REPO_ROOT
    if str(codedendrite_root) not in sys.path:
        sys.path.insert(0, str(codedendrite_root))
    from analyzer.shared.codedendrite_ignore import CodeDendriteIgnore

    rules = CodeDendriteIgnore(str(target))
    should_scan = rules.should_scan(candidate)
    in_map = rules.should_include_in_map(candidate)
    masked = rules.should_mask_content(candidate)
    try:
        display = candidate.relative_to(target)
    except ValueError:
        display = candidate
    print(f"路径：{display}")
    print(f"扫描：{'是' if should_scan else '否'}")
    print(f"地图展示：{'是' if in_map else '否'}")
    print(f"内容脱敏：{'是' if masked else '否'}")
    if not should_scan:
        print("结果：scan_exclude")
    elif masked:
        print("结果：privacy_mask")
    elif not in_map:
        print("结果：map_exclude")
    else:
        print("结果：正常扫描和展示")
    return 0


def show_anchor_code(target: Path, symbol: str, context: int = 0) -> int:
    """Print one indexed function/class body with line numbers."""
    if context < 0:
        raise SystemExit("--context 不能小于 0")

    codedendrite_root = REPO_ROOT
    if str(codedendrite_root) not in sys.path:
        sys.path.insert(0, str(codedendrite_root))

    from analyzer.anchors import load_anchors
    from api.inspector import get_anchor_source

    anchors = load_anchors(str(target))
    candidates = []

    exact_id = anchors.get(symbol)
    if exact_id is not None and not exact_id.is_virtual:
        candidates = [exact_id]
    else:
        candidates = [
            anchor
            for anchor in anchors.values()
            if not anchor.is_virtual and anchor.id == symbol
        ]

    if not candidates:
        exact_symbol = [
            anchor
            for anchor in anchors.values()
            if not anchor.is_virtual and anchor.symbol == symbol
        ]
        suffix_symbol = [
            anchor
            for anchor in anchors.values()
            if (
                not anchor.is_virtual
                and anchor.symbol.endswith("." + symbol)
                and anchor not in exact_symbol
            )
        ]
        candidates = exact_symbol or suffix_symbol

    if not candidates:
        keyword = symbol.lower()
        suggestions = [
            anchor
            for anchor in anchors.values()
            if not anchor.is_virtual and keyword in anchor.symbol.lower()
        ][:10]
        print(f"没有找到函数或类：{symbol}", file=sys.stderr)
        if suggestions:
            print("可能是：", file=sys.stderr)
            for anchor in suggestions:
                print(f"  {anchor.id}", file=sys.stderr)
        return 1

    unique = {anchor.id: anchor for anchor in candidates}
    if len(unique) > 1:
        print(f"名称不唯一，请改用完整 anchor ID：{symbol}", file=sys.stderr)
        for anchor_id in sorted(unique):
            print(f"  {anchor_id}", file=sys.stderr)
        return 2

    anchor = next(iter(unique.values()))
    result = get_anchor_source(anchor.id, str(target), context=context)
    if result is None:
        print(f"找到了 anchor，但无法读取源码：{anchor.id}", file=sys.stderr)
        return 1

    print(f"{result['symbol']}  {result['file']}:{result['line_start']}-{result['line_end']}")
    print(result["source"])
    return 0


def add_root(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("directory", nargs="?", default=".", help="项目目录，默认当前目录")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="cdd",
        add_help=False,
        description=(
            "CodeDendrite 人用命令。所有命令的项目目录都可省略，省略时使用当前目录。"
        ),
        formatter_class=argparse.RawTextHelpFormatter,
        epilog=(
            "【最短工作流】\n"
            "  cd 你的项目\n"
            "  cdd update\n"
            "  cdd status\n"
            "  cdd file backend/main.py\n"
            "  cdd chain 'backend/main.py::Class.method'\n"
            "\n"
            "【索引】\n"
            "  cdd update [目录]                 首次自动全量建立，之后增量更新\n"
            "  cdd rebuild [目录]                强制全量重建\n"
            "  cdd status [目录]                 查看索引位置、数量、更新时间\n"
            "  cdd peek <文件>                   现场解析一个文件，不需要索引\n"
            "  cdd outline [目录]                生成目录/文件/符号大纲\n"
            "\n"
            "【Ignore 配置】\n"
            "  cdd ignore init [目录]            创建默认 .codedendrite_ignore\n"
            "  cdd ignore list [目录]            分组查看当前规则\n"
            "  cdd ignore show [目录]            查看原始配置文件\n"
            "  cdd ignore add <规则> [目录]       完全不扫描，默认 kind=scan\n"
            "  cdd ignore add tests/ --kind map   扫描但不在地图展示\n"
            "  cdd ignore add .env --kind privacy 展示符号但隐藏内容\n"
            "  cdd ignore remove <规则> [目录]    删除规则，--kind 与添加时一致\n"
            "  cdd ignore check <路径> [目录]     检查某个路径最终如何处理\n"
