def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    target = project_dir(getattr(args, "directory", "."))
    target_arg = str(target)

    if args.command == "update":
        command = [target_arg, "--update"]
        if args.virtual:
            command.append("--virtual-blocks")
        if args.files is not None:
            command.extend(["--changed-files", *args.files])
        if args.topology_only:
            command.append("--topology-only")
        return run_module("usage.cli", command)
    if args.command == "rebuild":
        command = [target_arg]
        if args.virtual:
            command.append("--virtual-blocks")
        return run_module("usage.cli", command)
    if args.command == "status":
        return show_status(target)
    if args.command == "peek":
        return peek_file(target, args.file)
    if args.command == "ignore":
        if args.ignore_command == "init":
            return init_ignore(target)
        if args.ignore_command == "list":
            return list_ignore(target)
        if args.ignore_command == "show":
            return list_ignore(target, raw=True)
        if args.ignore_command == "add":
            return add_ignore_rule(target, args.kind, args.pattern)
        if args.ignore_command == "remove":
            return remove_ignore_rule(target, args.kind, args.pattern)
        if args.ignore_command == "check":
            return check_ignore(target, args.path)
        raise SystemExit(f"未知 ignore 命令：{args.ignore_command}")
    if args.command == "path-role":
        return run_module(
            "usage.cli",
            [target_arg, "--path-policy-check", args.path],
        )
    if args.command == "eval":
        return unavailable("cdd eval", 'evaluation/ 评测流水线未随八桶重构迁入本树（迁移映射表列为不迁移，要跑得先把 evaluation/ 迁进来）')
    if args.command == "replay":
        command = [
            str(Path(args.tasks).expanduser().resolve()),
            str(Path(args.run_dir).expanduser().resolve()),
        ]
        if args.output:
            command.extend(["--output", str(Path(args.output).expanduser().resolve())])
        if args.snapshot_dir:
            command.extend(["--snapshot-dir", str(Path(args.snapshot_dir).expanduser().resolve())])
        return unavailable("cdd replay", 'evaluation/ 评测流水线未随八桶重构迁入本树（迁移映射表列为不迁移，要跑得先把 evaluation/ 迁进来）')
    if args.command == "snapshot":
        command = [
            target_arg,
            str(Path(args.issue).expanduser().resolve()),
            str(Path(args.output_dir).expanduser().resolve()),
            "--instance-id", args.instance_id,
        ]
        if args.base_commit:
            command.extend(["--base-commit", args.base_commit])
        return unavailable("cdd snapshot", 'evaluation/ 评测流水线未随八桶重构迁入本树（迁移映射表列为不迁移，要跑得先把 evaluation/ 迁进来）')
    if args.command == "action":
        command = [args.action_command, args.session_id, target_arg]
        if args.action_command == "done":
            if not args.kind or not args.target:
                raise SystemExit("cdd action done 需要 kind 和 target")
            command.extend([args.kind, args.target])
        command.extend(["--max-actions", str(args.max_actions)])
        return run_module("usage.action_session", command)

    require_index(target)

    if args.command == "outline":
        command = [target_arg, "--anchor-outline"]
        if args.output:
            command.extend(["--outline-output", args.output])
        return run_module("usage.cli", command)
    if args.command == "file":
        command = ["fileanchors", normalize_file(args.file, target), target_arg]
        if args.virtual:
            command.append("--with-virtual")
        return run_module("api.query", command)
    if args.command in {"code", "source", "cut"}:
        return show_anchor_code(target, args.symbol, context=args.context)
    if args.command == "find":
        return run_module(
            "api.query", ["edges", args.keyword, target_arg]
        )
    if args.command == "anchors":
        return run_module(
            "api.query", ["anchors", args.keyword, target_arg]
        )
    if args.command == "show":
        return run_module(
            "api.query", ["expand", args.node, target_arg]
        )
    if args.command in {"chain", "callers"}:
        direction = "down" if args.command == "chain" else "up"
        command = [
                "chain",
                args.symbol,
                target_arg,
                "--depth",
                str(args.depth),
                "--direction",
                direction,
            ]
        if args.command == "chain" and args.yaml:
            command.extend(["--yaml", str(Path(args.yaml).expanduser().resolve())])
        return run_module("api.query", command)
    if args.command == "chain2context":
        command = [
            "chain2context",
            args.symbol,
            target_arg,
            "--depth",
            str(args.depth),
            "--direction",
            args.direction,
            "--budget",
            str(args.budget),
            "--context",
            str(args.context),
        ]
        if args.output:
            command.extend(["--output", str(Path(args.output).expanduser())])
        return run_module("api.query", command)
    if args.command == "count":
        return run_module("api.query", ["count", target_arg])
    if args.command == "registered":
        command = ["registered", target_arg]
        if args.decorator:
            command.extend(["--decorator", args.decorator])
        return run_module("api.query", command)
    if args.command == "modules":
        return run_module(
            "usage.cli",
            [
                target_arg,
                "--modules",
                "--query",
                args.keyword,
                "--limit",
                str(args.limit),
            ],
        )
    if args.command == "owner":
        return run_module(
            "usage.cli",
            [target_arg, "--modules", "--symbol", args.symbol],
        )
    if args.command == "module":
        return run_module(
            "usage.cli",
            [target_arg, "--modules", "--module-id", args.module_id],
        )
    if args.command == "module-graph":
        command = [target_arg, "--module-graph"]
        if args.no_isolated:
            command.append("--no-isolated")
        return run_visual(
            "usage.cli",
            command,
            target / ".codedendrite" / "module_tree_graph.md",
            no_open=args.no_open,
        )
    if args.command == "context":
        command = [
            target_arg,
            "--task-context" if args.full else "--task-context-compact",
            args.query,
            "--model-profile",
            "large" if args.large else "small",
        ]
        if args.error:
            command.extend(["--error", args.error])
        return run_module("usage.cli", command)
    if args.command == "issue":
        command = [target_arg]
        if args.text:
            command.extend(["--issue", args.issue])
        else:
            command.extend(["--issue-file", str(Path(args.issue).expanduser().resolve())])
        if args.compact:
            command.append("--compact")
        if args.output:
            command.extend(["--output", str(Path(args.output).expanduser().resolve())])
        if args.session:
            command.extend(["--session", args.session, "--max-actions", str(args.max_actions)])
        return run_module("usage.packets.issue_evidence_packet", command)
    if args.command == "graph":
        command = ["graph"]
        if args.focus:
            command.append(args.focus)
        command.extend(["--radius", str(args.radius), "--root", target_arg])
        return run_visual(
            "api.query",
            command,
            target / ".codedendrite" / "relation_graph.html",
            no_open=args.no_open,
        )
    if args.command == "draw":
        if not args.no_refresh:
            result = run_module("usage.cli", [target_arg, "--update"])
            if result:
                return result
        output = target / ".codedendrite" / "anchor_browser.html"
        return run_visual_script(
            REPO_ROOT / "view" / "browser" / "build_file_index.py",
            [target_arg, "--output", str(output)],
            output,
            no_open=args.no_open,
        )
    if args.command == "map":
        return run_visual(
            "api.query",
            ["codemap", target_arg],
            target / ".codedendrite" / "code_map.html",
            no_open=args.no_open,
        )
    if args.command == "summary":
        return run_module(
            "api.query",
            ["map", "full" if args.full else "compact", target_arg],
        )
    if args.command == "timeline":
        command = [
            "timeline",
            args.symbol,
            target_arg,
            "--depth",
            str(args.depth),
        ]
        if args.error:
            command.extend(["--error", args.error])
        return run_visual(
            "api.query",
            command,
            target / ".codedendrite" / "call_timeline.html",
            no_open=args.no_open,
        )
    if args.command == "debug":
        command = [
            target_arg,
            "--debug-loop",
            "--file",
            normalize_file(args.file, target),
            "--error",
            args.error,
            "--limit",
            str(args.limit),
        ]
        if args.entry:
            command.extend(["--entry-symbol", args.entry])
        if args.target_symbol:
            command.extend(["--target-symbol", args.target_symbol])
        if args.conditions:
            command.extend(["--conditions", args.conditions])
        if args.edited_file:
            command.extend(["--edited-files", *args.edited_file])
        if args.edited_symbol:
            command.extend(["--edited-symbols", *args.edited_symbol])
        if args.no_refresh:
            command.append("--no-refresh")
        return run_module("usage.cli", command)
    if args.command == "tree":
        flag = {
            "build": "--module-tree-v2",
            "check": "--module-tree-v2-check",
            "render": "--module-tree-v2-html",
            "candidates": "--capability-candidates",
        }[args.tree_command]
        if args.tree_command in {"build", "render"}:
            return run_visual(
                "usage.cli",
                [target_arg, flag],
                target / ".codedendrite" / "module_tree_v2.html",
                no_open=args.no_open,
            )
        return run_module("usage.cli", [target_arg, flag])
    if args.command == "log-add":
        return run_module(
            "usage.profiles.autolog",
            [
                "add",
                args.symbol,
                target_arg,
                "--depth",
                str(args.depth),
                "--direction",
                args.direction,
            ],
        )
    if args.command == "log-file":
        return run_module(
            "usage.profiles.autolog",
            ["add-file", normalize_file(args.file, target), target_arg],
        )
    if args.command == "log-folder":
        return run_module(
            "usage.profiles.autolog",
            ["add-folder", normalize_file(args.folder, target), target_arg],
        )
    if args.command == "log-remove":
        return run_module("usage.profiles.autolog", ["remove", target_arg])

    raise SystemExit(f"未知命令：{args.command}")


if __name__ == "__main__":
    raise SystemExit(main())
