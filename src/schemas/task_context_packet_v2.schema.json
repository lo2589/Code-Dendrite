{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codedendrite.local/schemas/task_context_packet_v2.schema.json",
  "title": "CodeDendrite Issue Evidence Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "issue", "signals", "navigation", "candidates", "alternatives", "boundaries", "recommended_action", "action_policy"],
  "properties": {
    "version": {"const": "task_context_packet_v2"},
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "char_count", "sha256", "raw_text_included"],
      "properties": {
        "title": {"type": "string", "maxLength": 200},
        "char_count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_text_included": {"const": false}
      }
    },
    "signals": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "value", "source", "navigation_eligible"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]+$"},
          "kind": {"enum": ["anchor_id", "traceback_frame", "repo_path", "api_name", "exact_symbol", "error_type", "keyword"]},
          "value": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "navigation_eligible": {"type": "boolean"},
          "line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "reason", "candidate_files", "strong_evidence_count", "evidence_boundary"],
      "properties": {
        "status": {"enum": ["resolved", "ambiguous", "unresolved"]},
        "confidence": {"enum": ["high", "medium", "low", "none"]},
        "reason": {"type": "string", "minLength": 1},
        "candidate_files": {"type": "array", "maxItems": 7, "items": {"type": "string"}},
        "strong_evidence_count": {"type": "integer", "minimum": 0},
        "evidence_boundary": {"type": "string", "minLength": 1}
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "anchor", "symbol", "line", "resolution", "confidence", "evidence", "contradictions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[CA][0-9]+$"},
          "file": {"type": "string", "minLength": 1},
          "anchor": {"type": ["string", "null"]},
          "symbol": {"type": "string"},
          "line": {"type": ["integer", "null"], "minimum": 0},
          "resolution": {"enum": ["exact", "possible"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signal_id", "kind", "value", "strength"],
              "properties": {
                "signal_id": {"type": "string", "pattern": "^S[0-9]+$"},
                "kind": {"type": "string"},
                "value": {"type": "string"},
                "strength": {"type": "integer", "minimum": 0, "maximum": 4}
              }
            }
          },
          "contradictions": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]+$"}}
        }
      }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 7,
      "items": {"$ref": "#/properties/candidates/items"}
    },
    "boundaries": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "signal_id", "kind", "resolution", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^B[0-9]+$"},
          "signal_id": {"type": "string", "pattern": "^S[0-9]+$"},
          "kind": {"type": "string"},
          "resolution": {"enum": ["unresolved", "unsupported"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommended_action": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "argv", "because"],
          "properties": {
            "kind": {"enum": ["expand_anchor", "inspect_file"]},
            "target": {"type": "string", "minLength": 1},
            "argv": {"type": "array", "minItems": 3, "items": {"type": "string"}},
            "because": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S[0-9]+$"}}
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "executed_count", "max_actions", "status", "stop_reason", "action_id"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "executed_count": {"type": "integer", "minimum": 0},
        "max_actions": {"type": "integer", "minimum": 1},
        "status": {"enum": ["ready", "stopped"]},
        "stop_reason": {"type": ["string", "null"]},
        "action_id": {"type": ["string", "null"]}
      }
    },
    "action_policy": {"type": "string", "minLength": 1}
  }
}
