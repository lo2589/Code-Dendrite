{
  "name": "dsh-cdd-lens-pcb",
  "version": "0.1.5",
  "private": true,
  "description": "CodeDendrite Lens: the repository's real anchor graph as a floating canvas, lit by what the agent reads and edits, dimmed by what compaction took back.",
  "type": "commonjs",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "build.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
