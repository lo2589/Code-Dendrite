# ── 运行时缓存与临时产物 ──────────────────────────────────────
__pycache__/
*.pyc
*.lock
.cache/
.screenshot/
backup/
.playwright-cli/
output/playwright/
lens/output/playwright/

# ── 图片默认不进仓：截图/审计图属于临时产物（去 .cache/ 或 .screenshot/）──
# 例外：展示图和 README/代码实际引用的图，放 assets/ 才进仓。
*.png
*.jpg
*.jpeg
*.gif
*.webp
!/assets/**

# ── 文档不进仓 ────────────────────────────────────────────────
# 进仓的文档只有根 README 和 agent skill（npx skills add 从仓库里装 skills/*/SKILL.md）；
# 云端禁止任何其他文本类文件。
# 注意：pattern 后面不能跟行尾注释，会连注释一起当 pattern。
*.md
!/README.md
!/skills/*/SKILL.md
*.txt

# lens 设计稿是本地产物，不进仓
/lens/design/*.html
/lens-pcb/design/*.html
/lens-v2/
/multilanguage_debug/
# 评测 / 录屏的本地产物；README 要用的图放 /assets/
/output/

# ── 生成物：索引与产物，用 cdd rebuild 重生 ────────────────────
.codedendrite/
.code_genome_db.json
.code_hash_db.json
.code_anchors.json

# ── 本机文件 ──────────────────────────────────────────────────
CLAUDE.md
.DS_Store
*.
# 测试用的临时项目（test_integration.py 会就地造一个）
backend/
doc/*
docs/*
*.

# pip 打包产物
build/
*.egg-info/
